# ==========================================
# SupportMind AI - Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Client Port (Vite)
VITE_API_URL=http://localhost:5000/api

# Database Mode: "local" (default zero-friction) or "supabase"
DATABASE_MODE=local

# ------------------------------------------
# Supabase Configuration (Optional - Production)
# ------------------------------------------
# Set when using Supabase cloud / PostgreSQL database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# AI Provider Configuration
# ------------------------------------------
# Supported providers: "builtin" (deterministic grounded engine - no API key needed),
# "openai", "gemini", "ollama"
AI_PROVIDER=builtin

# OpenAI API Key (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (Local development using Llama 3.2 3B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------
# Admin Security
# ------------------------------------------
ADMIN_API_TOKEN=supportmind_admin_secret_token_2026
ADMIN_EMAIL=admin@supportmind.ai
