{
  "name": "supportmind-ai",
  "version": "1.0.0",
  "description": "SupportMind AI - Enterprise AI Customer Support Knowledge System (HACK-P380)",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "node scripts/dev.js",
    "install:all": "npm install",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build --workspace=client",
    "build:all": "npm run build:server && npm run build:client",
    "start": "npm run start --workspace=server",
    "test:api": "npm run test:api --workspace=server"
  },
  "keywords": [
    "ai",
    "customer-support",
    "knowledge-base",
    "rag",
    "react",
    "typescript",
    "supabase"
  ],
  "author": "SupportMind AI Team",
  "license": "MIT"
}
